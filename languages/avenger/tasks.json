[
  {
    "label": "Avenger: Watch $ZED_CUSTOM_avenger_chart ($ZED_RELATIVE_FILE)",
    "command": "target/release/avenger",
    "args": [
      "watch",
      "$ZED_FILE",
      "--chart",
      "$ZED_CUSTOM_avenger_chart",
      "--project-root",
      "$ZED_WORKTREE_ROOT"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["avenger-watch-named"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus",
    "hide": "never",
    "save": "all"
  },
  {
    "label": "Avenger: Watch anonymous chart ($ZED_RELATIVE_FILE)",
    "command": "target/release/avenger",
    "args": [
      "watch",
      "$ZED_FILE",
      "--project-root",
      "$ZED_WORKTREE_ROOT"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["avenger-watch-anonymous"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus",
    "hide": "never",
    "save": "all"
  }
]
