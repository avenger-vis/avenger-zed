avenger 1;
import './catalog.data.avenger' as data;

-- | Interactive chart fixture.
chart cartesian as values {
  param float64 as width {
    value: 640;
  }
  param store as rows {
    field float64 x;
  }
  mark symbol as points {
    x: coalesce($width@start, 0);
  }
  sql: FROM vega.movies AS m SELECT m."title";
}
