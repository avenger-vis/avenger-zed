avenger 1;
import { local as data } from './data.avenger';

-- | Interactive chart fixture.
export chart cartesian as values {
  param 640 as width;
  param store as rows {
    field float64 x;
  }
  mark symbol as points {
    x: coalesce($width@start, 0);
  }
  sql: FROM vega.movies AS m SELECT m."title";
}
